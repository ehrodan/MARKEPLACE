{
  "name": "@midas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/src/server.js",
    "start:test": "tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts' --exclude 'dist/**'",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --exclude 'dist/**'",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@midas/administration-audit": "workspace:*",
    "@midas/catalog": "workspace:*",
    "@midas/contracts": "workspace:*",
    "@midas/database": "workspace:*",
    "@midas/eventing": "workspace:*",
    "@midas/finance": "workspace:*",
    "@midas/identity": "workspace:*",
    "@midas/kernel": "workspace:*",
    "@midas/orders": "workspace:*",
    "@midas/progression": "workspace:*",
    "@midas/retention": "workspace:*",
    "@midas/sellers": "workspace:*",
    "fastify": "5.12.1",
    "fastify-type-provider-zod": "7.0.0",
    "nodemailer": "9.0.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
