# URL interna da API. O proxy same-origin do Next não expõe este endereço ao navegador.
MIDAS_API_URL=http://127.0.0.1:3001

# Sem uma versão vigente configurada, o cadastro falha fechado.
NEXT_PUBLIC_TERMS_VERSION=

# Identidade centralizada; pode ser alterada sem editar telas.
NEXT_PUBLIC_BRAND_NAME=OCHPOCH MARKET

# HTTPS público canônico. Ausente ou inválido mantém robots/sitemap fail-closed.
NEXT_PUBLIC_SITE_URL=
