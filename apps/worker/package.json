{
  "name": "@midas/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'dist/**'",
    "test:unit": "vitest run --exclude 'dist/**'",
    "test:integration": "vitest run --exclude 'dist/**'"
  },
  "dependencies": {
    "@midas/catalog": "workspace:*",
    "@midas/contracts": "workspace:*",
    "@midas/database": "workspace:*",
    "@midas/eventing": "workspace:*",
    "@midas/kernel": "workspace:*",
    "@midas/retention": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
