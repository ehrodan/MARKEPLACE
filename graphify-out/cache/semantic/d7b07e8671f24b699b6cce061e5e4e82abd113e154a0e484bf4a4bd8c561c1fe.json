{"nodes": [{"id": "docs_08_adrs_decisoes_arquiteturais_architectural_decision_register", "label": "Midas Architectural Decision Register", "file_type": "document", "source_file": "docs/08-ADRS-DECISOES-ARQUITETURAIS.md", "source_location": "L1-L38", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_08_adrs_decisoes_arquiteturais_implementation_status_registry", "label": "ADR Implementation Status Registry", "file_type": "document", "source_file": "docs/08-ADRS-DECISOES-ARQUITETURAIS.md", "source_location": "L40-L85", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_08_adrs_decisoes_arquiteturais_adr_001_modular_monolith", "label": "ADR-001 Modular Monolith with Specialized Processes", "file_type": "rationale", "source_file": "docs/08-ADRS-DECISOES-ARQUITETURAIS.md", "source_location": "L89-L160", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local transactions preserve critical invariants while domain boundaries and three deployable processes retain future extraction points."}, {"id": "docs_08_adrs_decisoes_arquiteturais_adr_002_postgresql_outbox_inbox", "label": "ADR-002 PostgreSQL Outbox Inbox and Explicit Concurrency", "file_type": "rationale", "source_file": "docs/08-ADRS-DECISOES-ARQUITETURAIS.md", "source_location": "L163-L241", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atomic outbox and inbox transactions prevent dual-write loss and make at-least-once delivery safe through idempotency and explicit locking."}, {"id": "docs_08_adrs_decisoes_arquiteturais_adr_003_identity_tenant_membership", "label": "ADR-003 User SellerAccount and SellerMembership", "file_type": "rationale", "source_file": "docs/08-ADRS-DECISOES-ARQUITETURAIS.md", "source_location": "L244-L321", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global identity, commercial tenant and authorization membership remain separate to prevent IDOR and cross-tenant leakage."}, {"id": "docs_08_adrs_decisoes_arquiteturais_adr_004_psp_ledger_hold_payout", "label": "ADR-004 PSP Ledger Hold Transfer and Payout Responsibilities", "file_type": "rationale", "source_file": "docs/08-ADRS-DECISOES-ARQUITETURAIS.md", "source_location": "L324-L412", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The PSP is authoritative for external movement while an append-only balanced ledger explains internal obligations without creating a wallet."}, {"id": "docs_08_adrs_decisoes_arquiteturais_adr_005_payment_quarantined", "label": "ADR-005 Late Settlement Enters PAYMENT_QUARANTINED", "file_type": "rationale", "source_file": "docs/08-ADRS-DECISOES-ARQUITETURAIS.md", "source_location": "L415-L500", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Late settlement must not reveal delivery or sell the same unit twice before safe reassociation or idempotent refund."}, {"id": "docs_08_adrs_decisoes_arquiteturais_adr_006_refund_separation", "label": "ADR-006 Refund Request Attempt Effect Separation", "file_type": "rationale", "source_file": "docs/08-ADRS-DECISOES-ARQUITETURAIS.md", "source_location": "L503-L590", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Human workflow, external attempts, PSP refund, ledger effect, ticket and dispute require distinct lifecycle and audit records."}, {"id": "docs_08_adrs_decisoes_arquiteturais_adr_007_pragmatic_cqrs", "label": "ADR-007 Pragmatic CQRS with Rebuildable Read Models", "file_type": "rationale", "source_file": "docs/08-ADRS-DECISOES-ARQUITETURAIS.md", "source_location": "L593-L674", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optimized projections may be eventually consistent but sensitive commands always re-read and reauthorize canonical write models."}, {"id": "docs_08_adrs_decisoes_arquiteturais_adr_008_growth_multitenant", "label": "ADR-008 Multi-Tenant Growth Freshness RLS and Safe Drill-Down", "file_type": "rationale", "source_file": "docs/08-ADRS-DECISOES-ARQUITETURAIS.md", "source_location": "L677-L770", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tenant-scoped, deduplicated projections with freshness and RLS prevent analytics from becoming a cross-tenant data leak or command authority."}, {"id": "docs_08_adrs_decisoes_arquiteturais_adr_009_contextual_authorization", "label": "ADR-009 Contextual Authorization SoD Step-Up and Audit", "file_type": "rationale", "source_file": "docs/08-ADRS-DECISOES-ARQUITETURAIS.md", "source_location": "L773-L862", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sensitive operations require deny-by-default contextual policy, separation of duties, recent authentication and append-only audit."}, {"id": "docs_08_adrs_decisoes_arquiteturais_adr_010_rest_idempotency_problem_json", "label": "ADR-010 REST v1 Idempotency and Problem Details", "file_type": "rationale", "source_file": "docs/08-ADRS-DECISOES-ARQUITETURAIS.md", "source_location": "L865-L959", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uniform REST, problem details, optimistic concurrency and durable idempotency make retries and asynchronous recovery predictable."}, {"id": "docs_08_adrs_decisoes_arquiteturais_adr_011_observability_replay_dr", "label": "ADR-011 Correlated Observability Controlled Replay and Tested DR", "file_type": "rationale", "source_file": "docs/08-ADRS-DECISOES-ARQUITETURAIS.md", "source_location": "L962-L1066", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Correlation, privileged replay, reconciliation and tested restore are required to prove recovery across asynchronous financial flows."}, {"id": "docs_08_adrs_decisoes_arquiteturais_adr_012_versioned_contract_gates", "label": "ADR-012 Versioned Contracts and Documentation Gates", "file_type": "rationale", "source_file": "docs/08-ADRS-DECISOES-ARQUITETURAIS.md", "source_location": "L1069-L1167", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OpenAPI, AsyncAPI, schemas, migrations, ADRs and traceability evolve together and block orphan or incompatible changes."}, {"id": "docs_08_adrs_decisoes_arquiteturais_adr_013_async_2d_3d_pipeline", "label": "ADR-013 Async Versioned Reviewed 2D-to-3D Pipeline", "file_type": "rationale", "source_file": "docs/08-ADRS-DECISOES-ARQUITETURAIS.md", "source_location": "L1170-L1322", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Untrusted and non-deterministic 3D generation requires isolated asynchronous processing, immutable artifacts, technical validation and human review."}, {"id": "docs_08_adrs_decisoes_arquiteturais_adr_014_payment_resolution_hold_payout", "label": "ADR-014 Payment Resolution 168h Hold and Evidenced Manual Payout", "file_type": "rationale", "source_file": "docs/08-ADRS-DECISOES-ARQUITETURAIS.md", "source_location": "L1325-L1375", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual financial operations converge on canonical settlement and require provider capability, maker-checker controls, evidence and reconciliation."}, {"id": "docs_08_adrs_decisoes_arquiteturais_adr_015_reputation_progression_leaderboard", "label": "ADR-015 Versioned Reputation Progression and Leaderboard Projections", "file_type": "rationale", "source_file": "docs/08-ADRS-DECISOES-ARQUITETURAIS.md", "source_location": "L1378-L1419", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reviews and progression remain explainable and rebuildable through immutable contributions, compensations and versioned policies."}, {"id": "docs_08_adrs_d