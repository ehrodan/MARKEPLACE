    "@midas/identity": "workspace:*",
    "@midas/kernel": "workspace:*",
    "@midas/sellers": "workspace:*",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
