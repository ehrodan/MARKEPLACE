{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.midas.example/events/finance.payment.settled.v1",
  "allOf": [
    { "$ref": "https://schemas.midas.example/events/outbox-event-envelope.v1" },
    { "type": "object", "properties": {
      "eventType": { "const": "finance.payment.settled.v1" },
      "schemaVersion": { "const": 1 }, "aggregateType": { "const": "Payment" },
      "sourceModule": { "const": "finance" }, "dataClassification": { "const": "FINANCIAL" },
      "payload": { "type": "object", "additionalProperties": false,
        "required": ["paymentId","orderId","sellerAccountId","amountMinor","currency","reconciliationStatus","settledAt","balanceLotId","holdId","eligibleAt"],
        "properties": {
          "paymentId": { "type": "string", "format": "uuid" }, "orderId": { "type": "string", "format": "uuid" },
          "sellerAccountId": { "type": "string", "format": "uuid" }, "amountMinor": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "reconciliationStatus": { "enum": ["RECONCILED_PROVIDER","RECONCILED_MANUAL"] },
          "settledAt": { "type": "string", "format": "date-time" }, "balanceLotId": { "type": "string", "format": "uuid" },
          "holdId": { "type": "string", "format": "uuid" }, "eligibleAt": { "type": "string", "format": "date-time" }
        }
      }
    } }
  ]
}
