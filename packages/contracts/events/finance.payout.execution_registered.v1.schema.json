{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.midas.example/events/finance.payout.execution_registered.v1",
  "allOf": [
    { "$ref": "https://schemas.midas.example/events/outbox-event-envelope.v1" },
    { "type": "object", "properties": {
      "eventType": { "const": "finance.payout.execution_registered.v1" }, "schemaVersion": { "const": 1 },
      "aggregateType": { "const": "PayoutRequest" }, "sourceModule": { "const": "finance" }, "dataClassification": { "const": "FINANCIAL" },
      "payload": { "type": "object", "additionalProperties": false,
        "required": ["payoutRequestId","payoutAttemptId","payoutStatus","amountMinor","currency","executedAt"],
        "properties": { "payoutRequestId": { "type": "string", "format": "uuid" }, "payoutAttemptId": { "type": "string", "format": "uuid" }, "payoutStatus": { "const": "CONFIRMATION_PENDING" }, "amountMinor": { "type": "string", "pattern": "^[1-9][0-9]*$" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "executedAt": { "type": "string", "format": "date-time" } }
      }
    } }
  ]
}
