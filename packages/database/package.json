{
  "name": "@midas/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'dist/**'",
    "test:unit": "vitest run --exclude 'dist/**'",
    "test:integration": "vitest run --exclude 'dist/**'",
    "db:generate": "tsx src/cli/verify-migration-layout.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "db:check": "tsx --env-file-if-exists=../../.env src/cli/check.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
